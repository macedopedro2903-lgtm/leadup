# ================================
# LeadUp - Variaveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NENHUM valor secreto deve ser commitado.
# ================================

# Conexao com o banco de dados (string de conexao Postgres)
DATABASE_URL=

# Segredos de autenticacao (gere strings aleatorias longas)
NEXTAUTH_SECRET=
AUTH_SECRET=

# Chave da API de IA (RouteLLM / Abacus.AI)
ABACUSAI_API_KEY=

# URL base da aplicacao. Em producao e definida automaticamente em runtime;
# para rodar localmente use http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# Credenciais usadas apenas pelo script de seed (scripts/seed.ts)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_INTERNAL_ADMIN_EMAIL=
SEED_INTERNAL_ADMIN_PASSWORD=

# WhatsApp Business Platform (Meta Cloud API + Embedded Signup v4)
# Configure no painel SEGURO da hospedagem. Nunca inclua valores reais no ZIP/GitHub.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Use a versão Graph API suportada pelo seu aplicativo Meta, por exemplo: v25.0
META_GRAPH_API_VERSION=
# Gere um segredo aleatório exclusivo para verificação inicial de webhook.
META_WEBHOOK_VERIFY_TOKEN=
# Chave AES-256-GCM: 32 bytes aleatórios codificados em base64 (apenas no ambiente seguro).
WHATSAPP_TOKEN_ENCRYPTION_KEY=
