# ================================
# LeadUp - Variaveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NENHUM valor secreto deve ser commitado.
# ================================

# Conexao com o banco de dados (string de conexao Postgres)
DATABASE_URL=

# Segredos de autenticacao (gere strings aleatorias longas)
NEXTAUTH_SECRET=
AUTH_SECRET=

# Chave da API de IA (RouteLLM / Abacus.AI)
ABACUSAI_API_KEY=

# URL base da aplicacao. Em producao e definida automaticamente em runtime;
# para rodar localmente use http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# Credenciais usadas apenas pelo script de seed (scripts/seed.ts)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_INTERNAL_ADMIN_EMAIL=
SEED_INTERNAL_ADMIN_PASSWORD=
