generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  START
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadStatus {
  NOVO
  PRIMEIRO_CONTATO
  AGUARDANDO_RESPOSTA
  ORCAMENTO_ENVIADO
  NEGOCIANDO
  FECHADO
  PERDIDO
}

enum PlanRequestStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum FollowupTone {
  AMIGAVEL
  PROFISSIONAL
  DIRETO
}

model User {
  id             String      @id @default(cuid())
  name           String?
  email          String      @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  businessName   String?
  whatsapp       String?
  plan           Plan        @default(FREE)
  planStatus     PlanStatus  @default(INACTIVE)
  planExpiresAt  DateTime?
  isAdmin        Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  leads         Lead[]
  followups     Followup[]
  aiUsage       AiUsage[]
  planRequests  PlanRequest[]
  whatsappConnection WhatsAppConnection?
  importAudits   LeadImportAudit[]
  quotes Quote[]
  activities LeadActivity[]
  passwordResets PasswordReset[]
  sessionVersion Int @default(0)
  accounts      Account[]
  sessions      Session[]

  @@index([email])
}

model Lead {
  id           String     @id @default(cuid())
  userId       String
  name         String
  phone        String?
  normalizedPhone String?
  company      String?
  email        String?
  importOrigin String?
  source       String @default("MANUAL")
  createdAutomatically Boolean @default(false)
  lastContactAt DateTime?
  lastMessageAt DateTime?
  service      String?
  value        Float?
  status       LeadStatus @default(NOVO)
  notes        String?
  nextFollowup DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  followups Followup[]
  messages LeadMessage[]
  quotes Quote[]
  activities LeadActivity[]
  followupEnabled Boolean @default(true)
  followupAfterDays Int @default(3)

  @@index([userId])
  @@index([userId, status])
  @@unique([userId, normalizedPhone])
}

model Followup {
  id            String        @id @default(cuid())
  userId        String
  leadId        String
  message       String
  tone          FollowupTone?
  generatedByAi Boolean       @default(false)
  createdAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  type      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model PlanRequest {
  id        String            @id @default(cuid())
  userId    String
  plan      Plan              @default(START)
  status    PlanRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model PlanChangeLog {
  id        String   @id @default(cuid())
  adminId   String
  userId    String
  oldPlan   String
  newPlan   String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AppSetting {
  key   String @id
  value String
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LeadImportAudit {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  total     Int
  created   Int
  updated   Int
  skipped   Int
  errors    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/** Incoming messages are written only by a trusted, authenticated provider integration. */
model LeadMessage {
  id                String   @id @default(cuid())
  userId            String
  leadId            String
  providerMessageId String
  body              String
  receivedAt        DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([userId, providerMessageId])
  @@index([userId, leadId, receivedAt])
}


/** A unique, explicitly authorized Cloud API phone per LeadUp user. */
model WhatsAppConnection {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wabaId            String
  phoneNumberId     String   @unique
  displayPhone      String?
  encryptedToken    String
  status            WhatsAppConnectionStatus @default(PENDING_REGISTRATION)
  tokenExpiresAt    DateTime?
  lastCheckedAt     DateTime?
  connectedAt       DateTime @default(now())
  activatedAt       DateTime?
  lastInboundAt     DateTime?
  lastError         String?
  skippedMessages   Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@index([wabaId])
}

enum WhatsAppConnectionStatus {
  PENDING_REGISTRATION
  CONNECTED
  REAUTH_REQUIRED
}

model Quote {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title String
  description String?
  amount Decimal @db.Decimal(12, 2)
  status QuoteStatus @default(RASCUNHO)
  validUntil DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
  @@index([userId, leadId])
}

enum QuoteStatus {
  RASCUNHO
  ENVIADO
  ACEITO
  RECUSADO
}

model LeadActivity {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind String
  summary String
  createdAt DateTime @default(now())
  @@index([userId, leadId, createdAt])
}

model PasswordReset {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
